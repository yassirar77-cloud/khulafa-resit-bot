# Khulafa Resit Bot — Render environment variables.
# Copy what you need into the Render service; never commit real values.
# Required ones are marked (required); everything else has the default shown.

# --- Telegram / storage (required) -------------------------------------------
TELEGRAM_BOT_TOKEN=                 # (required) bot token from @BotFather
SUPABASE_URL=                       # (required) project URL
SUPABASE_KEY=                       # (required) service-role key (the bot writes)
ALERT_CHAT_ID=                      # (required) the director chat / alert group id
YASSIR_CHAT_ID=                     # reviewer (director) Telegram user id; commands are gated on it
ARIFFIN_CHAT_ID=                    # optional second reviewer
PORT=10000                          # health server port (Render sets it)
WEBAPP_URL=                         # Mini App dashboard URL (optional)

# --- Receipt OCR (GLM via ZAI) ------------------------------------------------
ZAI_API_KEY=                        # (required) receipt OCR
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-4.6v-flash            # first-pass OCR model
ZAI_VERIFY_MODEL=glm-4.6v-flash     # second-pass verification model
ZAI_OCR_PROVIDER=glm-4.6v-flash     # or glm-ocr for the cheaper layout endpoint
ZAI_OCR_MODEL=glm-ocr
ZAI_OCR_TIMEOUT=60
IMAGE_RESIZE_ENABLED=true
IMAGE_MAX_DIM=1600
OCR_MAX_CONCURRENCY=2               # receipts decoded at once (memory guard)
REVIEW_CONFIDENCE_FLOOR=70          # below this a receipt goes to manual review
QWEN_SHADOW_ENABLED=false           # Qwen OCR shadow comparison (needs QWEN_API_KEY)
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-plus
QWEN_OCR_TIMEOUT=60
CLOUDINARY_URL=                     # receipt photo archive (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=receipts

# --- POS sales ingestion (Gmail) ----------------------------------------------
GMAIL_INBOX=                        # mailbox the POS shift-close emails land in
GMAIL_APP_PASSWORD=

# --- Reports and their delivery gates ------------------------------------------
MANAGER_DELIVERY_ENABLED=false      # false = every manager message routes to the owner with [TEST]
DIRECTOR_FEED=focus                 # focus | full — how much of the receipt feed the director sees
DIRECTOR_SPIKE_MIN_PCT=10           # price rise (%) worth a director line
GROUP_MONEY_REPORTS=                # comma list of outlet codes whose groups may see RM figures
KITCHEN_LOG_ENABLED=false           # 18:00 / 02:00 kitchen usage forms
COOK_PLAN_ENABLED=false             # 11:00 cook-to-demand plan
ORDER_DRAFT_SEND_HOUR=20            # evening order-draft job hour (MY)
CADENCE_LOOKBACK_DAYS=90            # buying history window for order drafts
NUMPAD_STATE_TTL_S=21600            # kitchen numpad state lifetime (seconds)

# --- DeepSeek staff chat (staff_ai / staff_chat) --------------------------------
STAFF_CHAT_AI=deepseek              # wording provider; only deepseek exists today
DEEPSEEK_API_KEY=                   # (required for AI wording; without it every message is the plain template)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
STAFF_CHAT_STYLE=classic            # classic (check-ins off) | preview (director-only digests; live outlets get them)
STAFF_CHAT_LIVE_OUTLETS=            # comma list of outlet codes whose groups get the check-ins, e.g. BISTRO7,SEK7
STAFF_CHAT_SLOTS=                   # comma list of check-ins to run (empty = all): open,stock,cook,lunch,order,bills,night,leftover,sales,wastage,afternoon,invoice,minimarket,po_mismatch

# Follow-up nudges (staff_nudge): two per unanswered check-in, 07:00-23:30 only
NUDGE_AFTER_MIN=40                  # minutes without a reply before nudge 1, again before nudge 2, expiry one window later
NUDGE_SLOTS=                        # check-ins that get nudges (empty = every scheduled check-in + invoice, minimarket, po_mismatch)

# Anomaly questions (staff_anomaly)
ANOMALY_PCT=35                      # % off the trailing 4-week same-weekday average that turns a check-in into a targeted question

# Receipt-vs-order mismatch (po_mismatch)
PO_PRICE_PCT=10                     # unit price this % off the usual paid price counts as a mismatch

# Voice replies (staff_voice): Groq-hosted Whisper, always with the cashier's /lang language
STAFF_VOICE_AI=groq                 # speech-to-text provider (only groq exists)
GROQ_API_KEY=                       # (required for voice notes; without it they get "please type it")
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1
VOICE_MIN_CONFIDENCE=0.6            # transcripts below this ask the cashier to type instead

# Director Q&A (director_sql) — free text in the director chat -> one read-only SELECT
DIRECTOR_QA=off                     # on | off; needs migrations/0055 (read-only role + director_sql() function)
