# khulafa-resit-bot — environment variables
# Copy to .env (never commit it) or set these in Render's dashboard.
# REQUIRED vars crash the bot at import with a KeyError when missing.

# --- REQUIRED (bot.py crashes without these) ---------------------------------
TELEGRAM_BOT_TOKEN=                 # BotFather token
ZAI_API_KEY=                        # Z.AI key for GLM OCR/vision
SUPABASE_URL=                       # https://<project>.supabase.co
SUPABASE_KEY=                       # service-role key (bypasses RLS; server-side only)
ALERT_CHAT_ID=                      # numeric chat id for owner alerts / daily summary

# --- Reviewers / recipients ---------------------------------------------------
YASSIR_CHAT_ID=                     # owner chat id; enables admin commands + review queue.
                                    # UNSET => every admin command is silently ignored.
#ARIFFIN_CHAT_ID=                   # optional second reviewer
#DIGEST_RECIPIENTS=                 # comma-separated chat ids for the 23:00 digest
                                    # (falls back to YASSIR_CHAT_ID)

# --- Sales email ingestion (poll no-ops when unset) ---------------------------
#GMAIL_INBOX=                       # Gmail address receiving POS shift-close emails
#GMAIL_APP_PASSWORD=                # Gmail app password (not the account password)

# --- Kitchen usage log (SEK-20) ------------------------------------------------
#KITCHEN_LOG_ENABLED=1              # unset => whole kitchen pipeline no-ops
#NUMPAD_STATE_TTL_S=21600           # numpad buffer eviction TTL (memory guard)

# --- Weekly manager reports / order drafts -------------------------------------
#MANAGER_DELIVERY_ENABLED=1         # unset => all reports route to owner with [TEST]
#ORDER_DRAFT_SEND_HOUR=20           # evening order-draft cron hour (MY time)
#CADENCE_LOOKBACK_DAYS=45

# --- OCR / models ---------------------------------------------------------------
#ZAI_BASE_URL=                      # override Z.AI endpoint
#ZAI_MODEL=glm-4.6v-flash
#ZAI_VERIFY_MODEL=                  # defaults to ZAI_MODEL
#ZAI_OCR_PROVIDER=                  # chat | ocr endpoint selection
#ZAI_OCR_MODEL=glm-ocr
#ZAI_OCR_TIMEOUT=60
#ZAI_OCR_BASE_URL=
#OCR_MAX_CONCURRENCY=1              # default 1 (512MB-safe); raise only on bigger instances
#IMAGE_RESIZE_ENABLED=true
#IMAGE_MAX_DIM=1600
#REVIEW_CONFIDENCE_FLOOR=

# --- Qwen shadow OCR (offline eval only; scripts/qwen_shadow_*) -----------------
#QWEN_SHADOW_ENABLED=               # if set, QWEN_API_KEY becomes required
#QWEN_API_KEY=
#QWEN_API_URL=
#QWEN_VL_MODEL=qwen3.6-plus
#QWEN_OCR_TIMEOUT=60
#QWEN_TOKEN_BUDGET=

# --- Receipt image archival (Cloudinary; off when unset) ------------------------
#CLOUDINARY_URL=                    # or the trio below
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=
#CLOUDINARY_UPLOAD_FOLDER=receipts

# --- Web / misc ------------------------------------------------------------------
#SUPABASE_ANON_KEY=                 # served to the /webapp dashboard browser client
#PORT=10000                         # health server port
#WEBAPP_URL=                        # Mini App dashboard URL
#SUPABASE_SERVICE_KEY=              # scripts-only fallback for SUPABASE_KEY
